# Copy this file to ".env" and fill in the blanks. NEVER commit .env.
#
# Where to get these (Tastytrade web platform -> Manage -> API access):
#   1. Create an OAuth application (callback http://localhost:8000)
#      -> copy the Client Secret (shown once)
#   2. Create a personal grant -> copy the Refresh Token (shown once)

TASTY_CLIENT_SECRET=replace-me
TASTY_REFRESH_TOKEN=replace-me

# Operator switch. When anything but "true", no order can go live.
LIVE_TRADING_ENABLED=false

# Fail-closed auth. Live orders are refused while this is empty.
# On the Worker it is also the bearer token clients must send to /mcp, and the
# endpoint answers 503 to everyone until it is set (32+ characters).
MCP_AUTH_TOKEN=

# Per-order confirmation: the tool must be called with confirm="CONFIRM".
# Claude asks you in the chat before it sends that.
